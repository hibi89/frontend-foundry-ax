{
  "name": "frontend-foundry-ax",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Local-first FFAX workbench with owner-approved HTTPS model adapter, schema-based visual editing, browser QA and safe Git review.",
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "python scripts/browser_qa.py",
    "check": "npm test && npm run test:browser",
    "test:integration": "node --test tests/workspace.test.mjs tests/react-tsx-interactions.test.mjs tests/github-review.test.mjs",
    "test:policy": "node --test tests/ai-gate.test.mjs",
    "test:react-compile": "node scripts/react_export_probe.mjs",
    "test:react-runtime": "python scripts/react_runtime_probe.py",
    "test:accessibility": "python scripts/accessibility_probe.py",
    "test:model-contract": "node scripts/model_contract_probe.mjs",
    "test:contrast": "python scripts/contrast_probe.py",
    "test:local-acceptance": "node scripts/local_acceptance_gate.mjs",
    "check:offline": "npm test && npm run test:model-contract && npm run test:react-runtime && npm run test:accessibility && npm run test:local-acceptance",
    "test:manual-browser": "python scripts/manual_browser_probe.py",
    "test:cleanroom": "node scripts/cleanroom_gate.mjs",
    "test:provider-contract": "node scripts/provider_contract_probe.mjs",
    "test:axe": "python scripts/axe_offline_audit.py"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "axe-core": "4.14.0"
  }
}
