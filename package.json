{
  "name": "frontend-foundry-ax",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local-first FFAX: structured UI editor plus read-only React snapshot, approved UI patch, regression fixtures and draft PR review gate.",
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "python scripts/browser_qa.py",
    "check": "npm test && npm run test:browser",
    "test:integration": "node --test tests/workspace.test.mjs tests/react-tsx-interactions.test.mjs tests/github-review.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
